# Frontend Environment Variables
# Copy this to .env.local and fill in your values

# Backend API URL
# Leave blank to use the same-origin Next.js proxy (recommended for LAN/phone use).
NEXT_PUBLIC_API_URL=

# Public application URL encoded by Resource Passport QR codes.
# Use a LAN-reachable URL when scanning from a phone during a field demo.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional for MVP)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
