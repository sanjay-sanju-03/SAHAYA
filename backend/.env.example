# OpenAI (required for live text/image extraction and audio transcription)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
# Set false only when you want deterministic assistant fallbacks without
# optional LLM phrasing. The assistant remains read-only in either mode.
SAHAYA_ASSISTANT_USE_LLM=true

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
STORE_BACKEND=memory

# Supabase persistence (required before production use)
# Backend only: use the Supabase secret key (sb_secret_...) here. Never expose
# it to the frontend. SUPABASE_SERVICE_ROLE_KEY remains a legacy fallback.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Optional; not used by the backend persistence layer.
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SCHEMA=public
